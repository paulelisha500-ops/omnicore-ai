# Copy this file to .env in the project root, then edit it:
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows cmd)
# Never commit the real .env file - it's already in .gitignore.

# ── LLM provider ─────────────────────────────────────────────────────────
# "ollama"    = your own self-hosted model (default, no per-token cost)
# "anthropic" = call Claude instead — set this and ANTHROPIC_API_KEY below
LLM_PROVIDER=ollama

# ── Self-hosted (Ollama) ────────────────────────────────────────────────
# These defaults run entirely on CPU with `docker compose up --build` — no
# GPU, no cloud account, no extra flags. Slower (a reply can take 10-60s),
# but real inference, completely free, and the fastest way to confirm the
# whole pipeline works before setting up a GPU.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
SEARXNG_URL=http://searxng:8080  # self-hosted web search the Chat Assistant/Research Agent can call — no API key needed

# Moving to a GPU later (see README.md section 3 for both topologies):
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
# and bump the text model up to something a GPU actually makes worthwhile:
#   OLLAMA_TEXT_MODEL=qwen3:14b
# If Ollama ends up on a separate remote box instead of this compose file:
#   OLLAMA_BASE_URL=http://<that instance's address>:11434

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────
# Signs login tokens. There is intentionally no default: anyone who knows this
# value can forge an admin login. Generate a fresh one for every deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── Anthropic (only needed if LLM_PROVIDER=anthropic) ───────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
